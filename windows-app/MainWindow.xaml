<Window x:Class="NothingLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOTHING LINK // CONTROL HUB"
        Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#0C0C0E"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Consolas, sans-serif"
        ResizeMode="CanMinimize">
    
    <Window.Resources>
        <!-- Primary Action Button (Nothing Red) -->
        <Style x:Key="NothingRedButton" TargetType="Button">
            <Setter Property="Background" Value="#D71921"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EA222B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B2141A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Frosted Dark) -->
        <Style x:Key="FrostedDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24242C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#444455"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#121215"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status Card -->
            <RowDefinition Height="Auto"/> <!-- Main Actions -->
            <RowDefinition Height="Auto"/> <!-- Settings & Tools Tabs -->
            <RowDefinition Height="*"/>    <!-- Console Output -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="NOTHING LINK" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Foreground="#FFFFFF"/>
                <TextBlock Text="Ultra-Low Latency 120 FPS Mirroring &amp; Remote Control • NOS 5.0" FontSize="11" Foreground="#777785" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#16161B" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                <TextBlock Text="v3.0.0 PRO" FontSize="11" FontFamily="Consolas" Foreground="#9999AA" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- 2. Device Status Card -->
        <Border Grid.Row="1" Background="#121216" BorderBrush="#22222A" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Dot -->
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="12" Height="12" Fill="#EAB308" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <!-- Device Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="Scanning for Nothing Phone..." FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="StatusDetails" Text="Checking USB cable and Wi-Fi hotspot connection..." FontSize="11" Foreground="#888898" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="2" Content="Scan Device" Style="{StaticResource FrostedDarkButton}" Padding="10,6" FontSize="11" Click="BtnScan_Click"/>
            </Grid>
        </Border>

        <!-- 3. Primary Action Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Screen-Off 120 FPS Mirror -->
            <Button Grid.Column="0" Style="{StaticResource NothingRedButton}" Margin="0,0,10,0" Click="BtnMirrorScreenOff_Click">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="⚡ MIRROR (SCREEN OFF)" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="120 FPS • Auto-Unlock • Phone Screen Black" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Screen-On Mirror -->
            <Button Grid.Column="1" Style="{StaticResource FrostedDarkButton}" Margin="0,0,10,0" Click="BtnMirrorScreenOn_Click">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="MIRROR (ON)" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Keep Screen Visible" FontSize="10" Foreground="#888898" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>

            <!-- Hotspot Remote Toggle -->
            <Button Grid.Column="2" Style="{StaticResource FrostedDarkButton}" Click="BtnToggleHotspot_Click">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="📶 HOTSPOT" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Toggle Phone Hotspot" FontSize="10" Foreground="#888898" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. Settings & Quick Tools Card -->
        <Border Grid.Row="3" Background="#121216" BorderBrush="#22222A" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Auto-Unlock Configuration -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="LOCK SCREEN AUTO-UNLOCK" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#9999AA" Margin="0,0,0,8"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbPattern" Content="Pattern" Foreground="#FFFFFF" IsChecked="True" Margin="0,0,12,0" Checked="LockType_Changed"/>
                        <RadioButton x:Name="RbPin" Content="PIN" Foreground="#FFFFFF" Margin="0,0,12,0" Checked="LockType_Changed"/>
                        <RadioButton x:Name="RbPassword" Content="Password" Foreground="#FFFFFF" Margin="0,0,12,0" Checked="LockType_Changed"/>
                        <RadioButton x:Name="RbNone" Content="Swipe/None" Foreground="#FFFFFF" Checked="LockType_Changed"/>
                    </StackPanel>

                    <!-- Lock Value Input -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLockCode" Grid.Column="0" Background="#18181F" Foreground="#FFFFFF" BorderBrush="#2F2F3D" Padding="8,6" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Save" Style="{StaticResource FrostedDarkButton}" Padding="12,5" Margin="8,0,0,0" FontSize="11" Click="BtnSaveSettings_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtLockHint" Text="Pattern sequence 1-9 (e.g. 159873). Dot map: 123 top, 456 mid, 789 btm." FontSize="10" Foreground="#666675"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="#22222A" Margin="16,0"/>

                <!-- Right: Quick Phone Utilities -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DEVICE UTILITIES" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#9999AA" Margin="0,0,0,8"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="1-Click Setup" Style="{StaticResource FrostedDarkButton}" Margin="0,0,6,0" Padding="8,8" FontSize="11" Click="BtnSetupDevice_Click"/>
                        <Button Grid.Column="1" Content="Start Shizuku" Style="{StaticResource FrostedDarkButton}" Margin="6,0,0,0" Padding="8,8" FontSize="11" Click="BtnStartShizuku_Click"/>
                    </Grid>

                    <Button Content="🌐 Open Cloud Web Dashboard (localhost:3000)" Style="{StaticResource FrostedDarkButton}" Padding="8,8" FontSize="11" Click="BtnOpenDashboard_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Console / Terminal Output -->
        <Border Grid.Row="4" Background="#0A0A0C" BorderBrush="#1C1C24" BorderThickness="1" CornerRadius="12" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="ACTIVITY CONSOLE" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#666675"/>
                    <Button Content="Clear" HorizontalAlignment="Right" Background="Transparent" Foreground="#666675" BorderThickness="0" Cursor="Hand" FontSize="10" Click="BtnClearLog_Click"/>
                </Grid>
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#A0A0B0" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
